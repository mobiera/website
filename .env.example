# Copy to .env.local for local development (.env* is gitignored). In production
# these come from the deployment's secret store; never ship a .env file.

# Canonical origin, used in metadata, sitemap, RSS and email links.
SITE_URL=https://mobiera.io

# Contact form: inquiries are emailed over SMTP (MAIL_* below), the same way
# 2060.io-website does it. Gmail / Google Workspace needs an App Password:
# enable 2-step verification on the sending account, then create one at
# https://myaccount.google.com/apppasswords. MAIL_PORT 587 = STARTTLS,
# 465 = SSL (or set MAIL_ENCRYPTION=ssl). With MAIL_HOST unset, submissions
# are accepted and logged, not delivered.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@mobiera.com
MAIL_FROM_NAME=Mobiera

# Recipients. CONTACT_TO is the default (comma-separated). Per-topic overrides
# use the topic value in upper snake case: aircast, ai-agents, trust,
# certification, partnership, careers, press, general.
CONTACT_TO=
CONTACT_TO_CAREERS=
CONTACT_TO_PRESS=

# Optional Discord/Slack-compatible webhook for ops alerts when delivery fails.
ALERT_WEBHOOK_URL=

# Certified integrators directory on /certification, generated from the Verana
# Trust Graph. Dormant until both are set: the graph's base URL and the ledger
# id of the "Verana Certified Integrator" credential schema issued by Mobiera.
# VERIFY_URL_TEMPLATE builds the per-entry verify link ({did} is replaced).
TRUST_GRAPH_URL=
CERTIFIED_INTEGRATOR_SCHEMA_ID=
VERIFY_URL_TEMPLATE=https://verana.io/identity?did={did}

# Optional Google Analytics 4 measurement id (G-XXXXXXXXXX). Empty disables
# analytics; the tag loads only after cookie consent. Build-time value: in
# production it is a GitHub repository variable passed to the Docker build.
NEXT_PUBLIC_GA_ID=
